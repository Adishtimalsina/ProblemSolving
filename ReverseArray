## Reverse the given array without creating new array.

int[] array = {1,2,3,4,5,6};

 public void reverseArray(int[] array) {
   
        int start = 0;
        int end = array.length-1;

        while(start<end){
            int temp = array[start];
            array[start] = array[end];
            array[end] = temp;
            start++;
            end--;
        }
        for(int arr : array){
            System.out.print(arr+" ");
        }
    }
